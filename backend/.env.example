PORT=5001

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub: whose public repos to list as projects
GITHUB_USERNAME=rkdxod211
# Optional: raises GitHub API rate limit from 60 to 5000 req/hour (no scopes needed)
GITHUB_TOKEN=
# Optional: comma-separated repo names to hide
GITHUB_EXCLUDE=

# Signs admin login tokens: any long random string (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN_SECRET=
